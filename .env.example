# Copy to .env.local for local development. Use the same values in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
STAFF_REGISTRATION_CODE=choose-a-long-private-code

# Run supabase/schema.sql once in your Supabase SQL Editor before using the app.
# Do not expose SUPABASE_SECRET_KEY to browser code.
