# Local development (copy to .env.local)
TURSO_DATABASE_URL=file:.data/grove.db
TURSO_AUTH_TOKEN=
STAFF_REGISTRATION_CODE=choose-a-long-private-code

# Vercel: set TURSO_DATABASE_URL to your hosted libsql:// database URL,
# TURSO_AUTH_TOKEN to its token, and STAFF_REGISTRATION_CODE to a private code.
# Never use a file: URL on Vercel.
